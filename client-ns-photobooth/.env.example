# Copy this file to `.env` and fill in the blank value below.
#
#   cp .env.example .env
#
# `.env` is gitignored because it holds an API key. Everything except that key
# is ordinary config, and the defaults here are the ones the booth runs with.

# ImgBB API key, used to host captured photos so the QR printed on each strip
# has somewhere to point. Get one free at https://api.imgbb.com/
#
# Read by the frontend for the initial upload, and by the backend (which falls
# back to reading this same file) when a photo is re-uploaded after being
# recoloured in the gallery — see _imgbb_api_key in backend/main.py. Set
# IMGBB_API_KEY in the backend's environment instead if you'd rather keep the
# two separate.
#
# Leave blank and the booth still works offline: turn on "Offline Only" in
# Settings and photos save locally with no upload and no QR.
VITE_IMGBB_API_KEY=

# Format/quality captured photos are encoded at.
VITE_IMG_UPLOAD_FORMAT=image/jpeg
VITE_IMG_UPLOAD_QUALITY=0.9

# Seconds an animation takes to fade in/out, and how long it keeps following a
# person after their pose is briefly lost before giving up.
VITE_ANIM_FADE=0.3
VITE_ANIM_RETRACK=1

# How many fly-around loops the owl does before landing.
VITE_ANIM_OWL_FLY_LOOPS=1

# Countdown shown before a photo is taken, in seconds.
VITE_PHOTO_COUNTDOWN=3
